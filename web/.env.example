# Public values only. Anything with a NEXT_PUBLIC_ prefix is visible in the browser.
# Never put secrets in this file or use NEXT_PUBLIC_ for a secret.

# Base URL of the HemFin API (no trailing slash).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase project URL and anon (publishable) key. Both are public by design: the browser needs them.
# Locally, copy them from `npx supabase status`. Never put the service-role key or any other secret here.
# Production: Supabase dashboard > Project Settings > API, set as Vercel environment variables.
# The API's SUPABASE_URL must use the same host (the token issuer is checked against it).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-from-supabase-status
