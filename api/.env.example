# Placeholders only. Never put real values in this file; real ones go in api/.env (gitignored).
# Config priority: env vars > secret files in SECRETS_DIR (default /etc/secrets) > .env

# SECRETS_DIR (optional, default /etc/secrets; Render mounts Secret Files there) holds one file
# per variable. It must be set as a real environment variable, not in this file.

# APP_ENV defaults to production when unset. Set it to local here (local dev only) to allow
# local-only behaviour such as HS256 tokens. Render sets production.
APP_ENV=local
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# SECRET. Production: Supabase dashboard > Database > pooler connection string, stored as a
# Render Secret File named DATABASE_URL (or an Environment Group entry).
# postgresql:// is rewritten to postgresql+asyncpg://
DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<db>

# Not secret. Production: Supabase project settings, set in the Render Environment Group.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
# Tokens are verified against {SUPABASE_URL}/auth/v1/.well-known/jwks.json (ES256/RS256) and the
# issuer must equal {SUPABASE_URL}/auth/v1. Locally use the same host the browser uses
# (http://127.0.0.1:54321), otherwise the issuer will not match.
# Optional tuning (seconds): key cache TTL, and the minimum gap between unknown-kid refetches.
# SUPABASE_JWKS_TTL_SECONDS=600
# SUPABASE_JWKS_MIN_REFETCH_SECONDS=30

# SECRET, LOCAL/TEST ONLY. The local Supabase CLI stack may sign tokens with HS256 and its legacy
# JWT secret (see `supabase status`). It is honoured only when APP_ENV is local or test; in any
# other environment it is ignored. Never set it in Render.
# SUPABASE_JWT_SECRET=

# SECRET (production only, set in Render; leave unset locally). Used by the /internal/jobs/*
# endpoints (X-Job-Secret header); must equal the repo Actions secret JOB_SECRET. Unset = the
# endpoints return 503.
# JOB_SECRET=

# SECRET. Resend API key for invitation emails (Render Secret File or Environment Group).
# Optional: without it the app starts, and creating or resending an invitation returns a 503.
# RESEND_API_KEY=
# Not secret. Sender address of invitation emails, on a domain verified in Resend.
EMAIL_FROM=HemFin <invites@example.com>
# Not secret. Public web origin used in invite links (the token goes in the URL fragment).
WEB_BASE_URL=http://localhost:3000

# Test-only: tests/conftest.py sets HEMFIN_TEST_MODE=1 to skip the startup DATABASE_URL check.
# NEVER set it in a real environment; the app refuses to start with it unless APP_ENV is local or test.
