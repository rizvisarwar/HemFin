# Placeholders only. Never put real values in this file; real ones go in api/.env (gitignored).
# Config priority: env vars > secret files in SECRETS_DIR (default /etc/secrets) > .env

# Optional: directory of secret files (file name = variable name).
# Production: Render mounts Secret Files at /etc/secrets.
SECRETS_DIR=/etc/secrets

APP_ENV=local
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# SECRET. Production: Supabase dashboard > Database > pooler connection string, stored as a
# Render Secret File named DATABASE_URL (or an Environment Group entry).
# postgresql:// is rewritten to postgresql+asyncpg://
DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<db>

# Not secret. Production: Supabase project settings, set in the Render Environment Group.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
