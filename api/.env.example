APP_ENV=local
# Postgres (Supabase pooler URL in hosted envs). postgresql:// is rewritten to postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
# Placeholders, used by the auth ticket
SUPABASE_URL=
SUPABASE_JWT_AUDIENCE=authenticated
