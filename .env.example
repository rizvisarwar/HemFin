# Used only by `docker compose` (copy to .env, which is gitignored). Placeholders only.
# The API's own settings live in api/.env.example; the web's in web/.env.example.

# SECRET (local only). Choose any value for the throwaway local Postgres container.
# Use letters and digits, or URL-encode special characters, because it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=

# Optional. Set to export API traces/metrics/logs over OTLP gRPC (for example to a local
# collector). Leave empty to keep telemetry off.
OTEL_EXPORTER_OTLP_ENDPOINT=
